# Copy to .env.local and fill in. EXPO_PUBLIC_* values are embedded in the app
# bundle, so only public values belong here — never a service-role key.

# Supabase project URL (connect-crm owns the project and its migrations)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (RLS protects the data)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set only for a build made for ONE organization: the finder then offers "Continue with" it. Leave it empty
# for the shared app, which asks "Find your community" and suggests no organization.
EXPO_PUBLIC_CENTER_SLUG=

# Web domain whose names open a community: jsh.<domain> opens JSH, app.<domain> lists the
# organizations to choose from. Optional, web build only; unset keeps one address for everyone.
EXPO_PUBLIC_MEMBER_BASE_DOMAIN=

# Public community dashboard linked from the menu. Optional; the center's
# branding.dashboard_url wins. Hidden when neither is set.
EXPO_PUBLIC_COMMUNITY_DASHBOARD_URL=

# Weaver portal that creates online checkouts at the organization's Stripe/PayPal
# (POST /api/payments/intent). Optional: without it the Pay sheet says online payment is not set up.
EXPO_PUBLIC_PORTAL_URL=
