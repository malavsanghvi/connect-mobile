# Copy to .env.local and fill in. EXPO_PUBLIC_* values are embedded in the app
# bundle, so only public values belong here — never a service-role key.

# Supabase project URL (connect-crm owns the project and its migrations)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (RLS protects the data)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Center (tenant) to open. Optional; defaults to "jsh".
EXPO_PUBLIC_CENTER_SLUG=jsh

# Public community dashboard linked from the menu. Optional; the center's
# branding.dashboard_url wins. Hidden when neither is set.
EXPO_PUBLIC_COMMUNITY_DASHBOARD_URL=

# Community Connect portal that creates online checkouts at the organization's Stripe/PayPal
# (POST /api/payments/intent). Optional: without it the Pay sheet says online payment is not set up.
EXPO_PUBLIC_PORTAL_URL=
