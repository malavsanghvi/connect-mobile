{
  "expo": {
    "name": "Connect",
    "slug": "connect-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "connect",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF7F0",
    "primaryColor": "#1B2C5C",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "org.connectplatform.member",
      "supportsTablet": true
    },
    "android": {
      "package": "org.connectplatform.member",
      "adaptiveIcon": {
        "backgroundColor": "#1B2C5C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#FBF7F0",
      "themeColor": "#1B2C5C"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#1B2C5C",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Connect to use the camera to scan event tickets when you volunteer at check-in.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Connect to use Face ID to unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B2C5C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
