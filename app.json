{
  "expo": {
    "name": "Weaver",
    "slug": "connect-mobile",
    "version": "1.15.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["connect", "communityconnect"],
    "userInterfaceStyle": "light",
    "backgroundColor": "#FBF7F0",
    "primaryColor": "#1B2C5C",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "org.connectplatform.member",
      "supportsTablet": true
    },
    "android": {
      "package": "org.connectplatform.member",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#FBF7F0",
      "themeColor": "#1B2C5C"
    },
    "runtimeVersion": "3",
    "updates": {
      "url": "https://u.expo.dev/d61c6e7c-7999-4c49-aa39-bef5baf1fea7"
    },
    "extra": {
      "eas": {
        "projectId": "d61c6e7c-7999-4c49-aa39-bef5baf1fea7"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#1B2C5C",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Weaver to use the camera to scan event tickets when you volunteer at check-in.",
          "microphonePermission": "Allow Weaver to use the microphone to record your recitation for a lesson your organization offers, and to listen while you practise it.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Weaver to use Face ID to unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B2C5C"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Weaver to choose photos you want to add to an event album.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Weaver to save event photos to your library.",
          "savePhotosPermission": "Allow Weaver to save event photos to your library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Weaver to use the microphone to record your recitation for a lesson your organization offers, and to listen while you practise it.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Weaver to use the microphone to record your recitation for a lesson your organization offers, and to listen while you practise it.",
          "speechRecognitionPermission": "Allow Weaver to turn what you say into text, so it can check your practice of a lesson. The app keeps only your score, not your voice.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.as"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
